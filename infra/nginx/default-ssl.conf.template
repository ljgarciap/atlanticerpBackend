# HTTP → HTTPS redirect
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# HTTPS — sirve React estático + proxea /api/* a Laravel
server {
    listen 443 ssl default_server;
    server_name ${NGINX_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${NGINX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 520M;

    # SCRUM-1032 — cabeceras de seguridad (ver security-headers.conf)
    include /etc/nginx/snippets/security-headers-https.conf;

    # Epic 11 — Seguridad Agéntica: copia del access log como archivo real (además del
    # destino por defecto a stdout vía nginx.conf) para que CrowdSec, que corre nativo en
    # el host EC2 y no en Docker, pueda leerlo directamente.
    access_log /var/log/nginx-crowdsec/access.log main;

    # Epic 11 — Seguridad Agéntica (ADR-005): ModSecurity + OWASP CRS. Arranca en
    # DetectionOnly (default de modsecurity.conf del paquete) — no bloquea tráfico todavía.
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec-main.conf;

    # DNS interno de Docker: re-resuelve el hostname de laravel cada 10s.
    # Evita 502 cuando el contenedor laravel se recrea y obtiene nueva IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $laravel_upstream laravel:9000;

    root  /var/www/frontend;
    index index.html;

    # CAP-02 — rechazo rápido: si hay más de N peticiones simultáneas a PHP, el exceso recibe 503 al instante
    # (JSON + Retry-After, sin pasar por PHP) en vez de encolarse. /up y la salud quedan exentos (más abajo).
    error_page 503 @busy;
    location @busy {
        default_type application/json;
        include /etc/nginx/snippets/security-headers-https.conf;
        add_header Retry-After "5" always;
        add_header Cache-Control "no-store" always;
        return 503 '{"message":"Servicio ocupado, intenta de nuevo en unos segundos","code":"server_busy"}';
    }

    # Salud: sin límite, para que las comprobaciones del despliegue y de las alarmas funcionen bajo saturación.
    location ~ ^/api/health(/deep)?$ {
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
        fastcgi_connect_timeout 5s;
        fastcgi_read_timeout 60s;
    }

    # Inicio de sesión: tope propio (bcrypt es lo más caro de la API).
    location = /api/auth/login {
        include /etc/nginx/snippets/load-shedding-login.conf;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
        fastcgi_connect_timeout 5s;
        fastcgi_read_timeout 60s;
    }

    # API Laravel — pasa directamente a PHP-FPM sin try_files para no romper POST
    location /api/ {
        include /etc/nginx/snippets/load-shedding.conf;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
        fastcgi_connect_timeout 5s;
        fastcgi_read_timeout 60s;
    }

    location = /up {
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    location /horizon {
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    # Share links (SCRUM) — endpoint público sin autenticación, sin prefijo /api,
    # tiene que llegar a Laravel y no caer en el catch-all de la SPA de más abajo.
    location /public/ {
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_pass $laravel_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param REQUEST_URI     $request_uri;
    }

    # Documentación interactiva de la API: solo dev (ver entrypoint.sh); el snippet queda vacío en test y prod.
    include /etc/nginx/snippets/api-docs.conf;

    location ~* \.(?:js|css)$ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers-https.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers-https.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
    }

    location = /version.json {
        include /etc/nginx/snippets/security-headers-https.conf;
        add_header Cache-Control "no-store";
        add_header Pragma "no-cache";
        expires 0;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
