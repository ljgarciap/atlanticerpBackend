# env.drill.example — .env MÍNIMO para la instancia desechable del simulacro (SCRUM-1029/966). SECRETOS NUEVOS: no se copia nada de
# dev, test ni prod. Se genera en la instancia con infra/drill/make-env.sh (rellena los valores aleatorios).
APP_NAME=AtlanticERP
APP_ENV=qa
APP_DEBUG=false
APP_KEY=__GENERAR__
APP_URL=http://drill.atlanticerp.invalid
FRONTEND_URL=http://drill.atlanticerp.invalid
TENANT_DEFAULT=atlantic
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atlanticerp
DB_USERNAME=atlanticerp
DB_PASSWORD=__GENERAR__
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=array
JWT_SECRET=__GENERAR__
JWT_EXPIRATION_MS=3600000
REFRESH_TOKEN_EXPIRATION_DAYS=30
MAIL_MAILER=log
# Sin credenciales de AWS ni de Anthropic: la instancia no debe poder tocar ningún bucket ni llamar a terceros.
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
THROTTLE_LOGIN_IP_MAX=100000
THROTTLE_LOGIN_EMAIL_MAX=100000
THROTTLE_REGISTER_IP_MAX=100000
