# =============================================================================
# AtlanticERP — Variables de entorno
# Copiar a .env y completar con valores reales. NUNCA commitear .env real.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_NAME=AtlanticERP
# local | qa | production
APP_ENV=local
# Generar con: php artisan key:generate (o "php artisan key:generate --show" en Docker)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL pública del frontend — DEBE coincidir con el dominio del entorno
# local: http://localhost:5173 | dev: https://dev.atlanticerp.ai | test: https://test.atlanticerp.ai | prod: https://atlanticerp.ai
FRONTEND_URL=http://localhost:5173
# Orígenes extra permitidos por CORS (coma). Por defecto solo APP_URL y FRONTEND_URL (SCRUM-1032).
CORS_ALLOWED_ORIGINS=

# Idioma de la aplicación (es) y de fallback (en) si falta una traducción
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
# Locale usado por Faker en seeders/factories
APP_FAKER_LOCALE=es_MX

# Zona horaria de negocio (SCRUM-883) — América/Panamá, GMT-5 sin horario de verano.
# Único valor válido para este cliente; no cambiar por entorno.
APP_TIMEZONE=America/Panama

# Driver de modo mantenimiento
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Costo del hash bcrypt para passwords
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Puerto local que nginx publica al host (Mac de desarrollo, evita choque con
# otros proyectos de Softclass en el mismo Docker daemon — binax usa 8090).
# En QA/Prod (EC2 dedicado) nginx publica el 80 estándar — ver
# infra/docker-compose.qa.yml e infra/docker-compose.prod.yml.
NGINX_PORT=8092

# Puerto local para acceso directo a Postgres desde el host (psql, cliente
# gráfico) — el contenedor laravel sigue usando DB_HOST=postgres/DB_PORT=5432
# por la red interna de Docker, esto no lo afecta. Distinto al 5432 que usa
# binax en este mismo Docker daemon.
DB_PORT_HOST=5434

# Dominio principal del entorno — usado por nginx SSL para seleccionar el
# certificado Let's Encrypt correcto. No aplica en local (docker-compose.yml).
# dev: dev.atlanticerp.ai | test: test.atlanticerp.ai | prod: atlanticerp.ai
NGINX_DOMAIN=

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
# Nombre del servicio en docker-compose (red interna del compose)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atlanticerp
# Esquema activo por defecto, formato {tenant}_{modulo} (multi-tenancy schema-per-tenant)
DB_SCHEMA=atlantic_auth
DB_USERNAME=atlanticerp
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Multi-tenancy (schema-per-tenant)
# -----------------------------------------------------------------------------
# Tenant por defecto cuando no se resuelve uno específico desde la request
TENANT_DEFAULT=atlantic

# -----------------------------------------------------------------------------
# Sesiones
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# Colas / Cache (Redis) y Broadcast
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

# Emails con acceso al dashboard de Horizon fuera de APP_ENV=local (separados por coma)
HORIZON_ADMIN_EMAILS=

REDIS_CLIENT=phpredis
# Nombre del servicio en docker-compose (red interna del compose)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Timeout de CONEXIÓN a Redis en segundos (SCRUM-1031): falla rápido y aplica la política fail-open/fail-closed.
REDIS_CONNECT_TIMEOUT=2

# -----------------------------------------------------------------------------
# Correo (SMTP)
# Desarrollo local: MAIL_MAILER=log  → emails van a storage/logs/laravel.log
# dev/test.atlanticerp.ai: MAIL_MAILER=smtp, MAIL_HOST=mailpit, MAIL_PORT=1025, sin encriptación ni
#   credenciales — captura en el contenedor mailpit (SCRUM-563, ver docker-compose.qa.yml). UI en
#   <IP-del-EC2>:8025, publicada por IP directa (sin dominio/SSL) — protegida por MAILPIT_UI_AUTH
#   abajo, nunca sin auth (captura correos reales de MFA/reset de password). Nunca usar el
#   Office365 real para probar envíos repetidos.
# Producción:        MAIL_MAILER=smtp → completar credenciales M365 reales
# Requisito M365: SMTP AUTH debe estar habilitado en el buzón:
#   Exchange Admin → Mailboxes → el usuario → Manage email apps → Authenticated SMTP ✅
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=correo@dominio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="correo@dominio.com"

# dev/test.atlanticerp.ai solamente — usuario:clave del auth básico nativo de la UI de Mailpit
# (formato "usuario:clave" en texto plano, Mailpit lo hashea internamente). Valor real SOLO en el
# .env de cada servidor, nunca acá ni en ningún archivo versionado.
MAILPIT_UI_AUTH=usuario:clave
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Storage
# Desarrollo local: FILESYSTEM_DISK=local (sin dependencias externas). Al
# desplegar (AWS u otro proveedor con storage S3-compatible), cambiar a s3 y
# completar las credenciales — todavía no decidido a qué proveedor.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# SCRUM-815 — bucket separado con S3 Object Lock (solo prod) para el backup inmutable de
# audit_logs, leído por infra/scripts/backup-audit-logs-immutable.sh (no por Laravel/config/
# filesystems.php — este env var solo lo consume el cron del EC2, no la app).
AWS_AUDIT_IMMUTABLE_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# URL base del bucket S3 (usado por los 3 discos s3/s3-private/s3-public para generar URLs).
# Ejemplo: https://s3.us-east-1.amazonaws.com/mi-bucket
# Dejar vacío para usar el endpoint estándar de AWS S3.
AWS_URL=
# URL del CDN para el disco s3-public (CloudFront u otro). Usada por DocumentService
# al construir la public_url de documentos públicos. Dejar vacío si no hay CDN.
CDN_URL=
# Hosts adicionales (separados por coma) desde los que se acepta catalog_products.photo_url (SCRUM-1038).
# Por defecto: host de CDN_URL, de AWS_URL y el bucket regional de S3.
CATALOG_PHOTO_EXTRA_HOSTS=

# -----------------------------------------------------------------------------
# Auth (JWT)
# Nota: Backend Dev las está incorporando en paralelo al middleware de Auth.
# Documentadas aquí como placeholder porque ya forman parte del stack aprobado
# (ver CLAUDE.md de AtlanticERP, sección "Stack aprobado" / Auth).
# -----------------------------------------------------------------------------
# Secreto usado para firmar los tokens JWT. Generar uno aleatorio y robusto,
# nunca reutilizar el de otro entorno.
JWT_SECRET=
# Expiración del access token, en milisegundos
JWT_EXPIRATION_MS=3600000
# Expiración del refresh token, en días
REFRESH_TOKEN_EXPIRATION_DAYS=30

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
# API key de Anthropic (Claude) usada por el módulo AI (Jobs async). Nunca
# exponer en el frontend.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Facturación electrónica — MSL (prep, sin decisión de proveedor tomada todavía,
# ver docs/architecture/facturacion-electronica-pac-diseno.md). Nunca hardcodear
# la key real ni commitearla — la entregada por MSL para pruebas ya viajó por
# correo/archivo en texto plano y debe rotarse antes de usarse en un entorno real.
# -----------------------------------------------------------------------------
# SCRUM-943 — sandbox y producción conviven a la vez en cada entorno; cuál se usa lo decide
# fiscal_settings.pac_ambiente (Configuración Fiscal, Mark-only), nunca una var de entorno.
MSL_FE_SANDBOX_BASE_URL=https://fedigifact.appmsl.com
MSL_FE_SANDBOX_API_KEY=
MSL_FE_PROD_BASE_URL=https://fedigifact.appmsl.com
MSL_FE_PROD_API_KEY=

# -----------------------------------------------------------------------------
# Outlook / Microsoft Graph (Calendario — SCRUM-66/177)
# -----------------------------------------------------------------------------
# App registration "AtlanticERP CRM - Calendar Integration" en el Azure AD del tercero
# que administra el tenant de Outlook. Flujo client_credentials (app-only) —
# el secret vence 2028-07-20, renovar antes en el mismo App Registration.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_SECRET_EXPIRES=

# -----------------------------------------------------------------------------
# Digifact — PAC directo, Facturación Electrónica (prep sin ticket, sin decisión de proveedor
# todavía — ver docs/architecture/facturacion-electronica-pac-diseno.md). Nunca commitear valores
# reales; las credenciales de prueba ya compartidas por el cliente se tratan como comprometidas.
# -----------------------------------------------------------------------------
DIGIFACT_BASE_URL_PRUEBAS=https://testnucpa.digifact.com/api
DIGIFACT_BASE_URL_PRODUCCION=https://nucpa.digifact.com/api
DIGIFACT_RUC=
DIGIFACT_USERNAME=
DIGIFACT_PASSWORD=
DIGIFACT_BRANCH_CODE=

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Registro público (SCRUM-1034): solicitudes por IP y ventana en segundos (ver config/throttle.php).
THROTTLE_REGISTER_IP_MAX=10
THROTTLE_REGISTER_IP_DECAY=3600
