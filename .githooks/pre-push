#!/usr/bin/env bash
# pre-push — exige un recibo verde del gate local (infra/gate.sh) para empujar a dev, test o master.
# Ver ADR-009. Activar en un clon nuevo con:  git config core.hooksPath .githooks
#
# - Empujar el MISMO sha a otra rama (promoción dev → test → master) pasa solo: el sha ya tiene recibo.
# - Un commit de solo documentación encima de uno con recibo hereda el recibo (ver infra/gate.sh --check).
# - Un push que solo toca docs/ o archivos .md no necesita recibo (tampoco corre CI en Actions).
# - Las etiquetas (tags) y las ramas que no son dev/test/master no se controlan.
# - Escape explícito y visible:  ATLANTICERP_SKIP_GATE=1 git push ...   (queda registrado en la salida).
set -uo pipefail

REPO="$(basename "$(git rev-parse --show-toplevel)")"
DIR="${ATLANTICERP_GATE_DIR:-$HOME/.atlanticerp-gate}/$REPO"
ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$REMOTE_REF" in
    refs/heads/dev|refs/heads/test|refs/heads/master) ;;
    *) continue ;;
  esac
  [[ "$LOCAL_SHA" == "$ZERO" ]] && continue   # borrado de rama

  if [[ "${ATLANTICERP_SKIP_GATE:-}" == "1" ]]; then
    echo "pre-push: ATLANTICERP_SKIP_GATE=1 — se omite el gate para ${REMOTE_REF#refs/heads/} (${LOCAL_SHA:0:8}). Queda bajo su responsabilidad." >&2
    continue
  fi

  # Cubierto = recibo verde del sha, o desciende de uno y solo cambió documentación (lógica en infra/gate.sh).
  if "$(git rev-parse --show-toplevel)/infra/gate.sh" --check "$LOCAL_SHA" >/dev/null 2>&1; then
    continue
  fi

  # Solo documentación respecto de lo que ya hay en el remoto → no hace falta recibo.
  if [[ "$REMOTE_SHA" != "$ZERO" ]] && git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null; then
    CHANGED="$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || echo '?')"
    if [[ -n "$CHANGED" && "$CHANGED" != "?" ]] && ! echo "$CHANGED" | grep -qvE '^docs/|\.md$|(^|/)\.gitignore$'; then
      echo "pre-push: solo documentación — sin recibo." >&2
      continue
    fi
  fi

  echo "pre-push: BLOQUEADO — ${LOCAL_SHA:0:8} no tiene recibo verde del gate local para empujar a ${REMOTE_REF#refs/heads/}." >&2
  echo "          Ejecute:  infra/gate.sh   (en $REPO, con ese commit en HEAD)" >&2
  echo "          o, de forma explícita:  ATLANTICERP_SKIP_GATE=1 git push ..." >&2
  STATUS=1
done

exit $STATUS
