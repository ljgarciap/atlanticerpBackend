# Entorno de pruebas (PHPUnit).
# Cargado automáticamente cuando APP_ENV=testing.
# Se pasa al contenedor con:
#   docker exec -e APP_ENV=testing infra-laravel-1 php artisan test --testsuite=Feature

APP_ENV=testing
APP_KEY=base64:o8mQEtenHL9iwJ3gLbP7z0a/23R7u7ysF1aITIk1jKE=
APP_DEBUG=false

# PostgreSQL real (mismo contenedor postgres que el entorno local)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atlanticerp_test
DB_SCHEMA=atlantic_auth
DB_USERNAME=atlanticerp
DB_PASSWORD=atlanticerp_local

# Multi-tenancy
TENANT_DEFAULT=atlantic

# JWT (secret de prueba — NO usar en producción)
JWT_SECRET=atlanticerp-testing-secret-key-do-not-use-in-prod
JWT_EXPIRATION_MS=3600000
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Cache / Colas en modo test
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BROADCAST_CONNECTION=null

# Mail
MAIL_MAILER=array

# Desactivar servicios innecesarios en tests
BCRYPT_ROUNDS=4
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
